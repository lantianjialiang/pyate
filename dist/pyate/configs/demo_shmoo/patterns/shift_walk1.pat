pattern shift_walk1;
pins    CLK, RSTN, SI, SO, Q0, Q1, Q2, Q3, Q4, Q5, Q6, Q7;
timing  tset_fast;
levels  lv_nominal;

  CLK=C RSTN=0 SI=0 SO=L Q=LLLLLLLL;
  CLK=C RSTN=1 SI=1 SO=L Q=HLLLLLLL;
  CLK=C RSTN=1 SI=0 SO=L Q=LHLLLLLL;
  CLK=C RSTN=1 SI=0 SO=L Q=LLHLLLLL;
  CLK=C RSTN=1 SI=0 SO=L Q=LLLHLLLL;
  CLK=C RSTN=1 SI=0 SO=L Q=LLLLHLLL;
  CLK=C RSTN=1 SI=0 SO=L Q=LLLLLHLL;
  CLK=C RSTN=1 SI=0 SO=L Q=LLLLLLHL;
  CLK=C RSTN=1 SI=0 SO=H Q=LLLLLLLH;
  halt;
