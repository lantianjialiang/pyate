# 失败示例：复位后第一拍 SO 仍是 0，这里写成了 H。通过的向量是 cnt_basic.pat。
# composite 是计数器加移位寄存器。复位后第一拍 SI=1，数据只进 S0，
# SO 是移位链的最高位，这一拍仍然是 0。
# 下面把这一拍的 SO 从 L 改成了 H。比较时期望 1、实际是 0，所以在 SO 上失败。
pattern cnt_fail;
pins    CLK, RSTN, EN, SI, SO, Q0, Q1, Q2, Q3, Q4, Q5, Q6, Q7, S0, S1, S2, S3, S4, S5, S6, S7;
timing  tset_fast;
levels  lv_nominal;

label start:
  CLK=C RSTN=0 EN=0 SI=0 SO=L Q=LLLLLLLL S=LLLLLLLL;
  CLK=C RSTN=1 EN=1 SI=1 SO=H Q=HLLLLLLL S=HLLLLLLL;
  CLK=C RSTN=1 EN=1 SI=0 SO=L Q=LHLLLLLL S=LHLLLLLL;
  CLK=C RSTN=1 EN=1 SI=1 SO=L Q=HHLLLLLL S=HLHLLLLL;
  CLK=C RSTN=1 EN=1 SI=0 SO=L Q=LLHLLLLL S=LHLHLLLL;
  CLK=C RSTN=1 EN=1 SI=1 SO=L Q=HLHLLLLL S=HLHLHLLL;
  CLK=C RSTN=1 EN=1 SI=0 SO=L Q=LHHLLLLL S=LHLHLHLL;
  CLK=C RSTN=1 EN=1 SI=1 SO=L Q=HHHLLLLL S=HLHLHLHL;
  CLK=C RSTN=1 EN=1 SI=0 SO=H Q=LLLHLLLL S=LHLHLHLH;
  CLK=C RSTN=1 EN=1 SI=0 SO=L Q=HLLHLLLL S=LLHLHLHL;
  CLK=C RSTN=1 EN=1 SI=0 SO=H Q=LHLHLLLL S=LLLHLHLH;
  CLK=C RSTN=1 EN=1 SI=0 SO=L Q=HHLHLLLL S=LLLLHLHL;
  CLK=C RSTN=1 EN=1 SI=0 SO=H Q=LLHHLLLL S=LLLLLHLH;
  CLK=C RSTN=1 EN=1 SI=0 SO=L Q=HLHHLLLL S=LLLLLLHL;
  CLK=C RSTN=1 EN=1 SI=0 SO=H Q=LHHHLLLL S=LLLLLLLH;
  CLK=C RSTN=1 EN=1 SI=0 SO=L Q=HHHHLLLL S=LLLLLLLL;
  CLK=C RSTN=1 EN=1 SI=0 SO=L Q=LLLLHLLL S=LLLLLLLL;
  CLK=C RSTN=1 EN=1 SI=0 SO=L Q=HLLLHLLL S=LLLLLLLL;
  CLK=C RSTN=1 EN=1 SI=0 SO=L Q=LHLLHLLL S=LLLLLLLL;
  CLK=C RSTN=1 EN=1 SI=0 SO=L Q=HHLLHLLL S=LLLLLLLL;
  CLK=C RSTN=1 EN=1 SI=0 SO=L Q=LLHLHLLL S=LLLLLLLL;
  halt;
